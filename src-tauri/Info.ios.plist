<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Hakawati uses the microphone to record speech and turn it into text.</string>
  <key>NSCameraUsageDescription</key>
  <string>Hakawati uses the camera to take photos you attach to a chat message and to scan codes that pair your devices.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Hakawati connects to AI servers you run on your local network.</string>
  <!-- Cloud saves are end-to-end encrypted with bundled AES-GCM and X25519, not
       Apple's crypto, so App Store Connect asks for export compliance. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <true/>
  <!-- Apps built with the iOS 27 SDK must run on the scene life cycle. Tao supplies
       the scene delegate once the app declares a manifest. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
  </dict>
</dict>
</plist>
